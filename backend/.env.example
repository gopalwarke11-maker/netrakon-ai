# Replace YOUR_PASSWORD; do not commit your real .env file.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/netrakon
APP_NAME=NETRAKON AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
API_PREFIX=/api
FRONTEND_URL=https://netrakon-ai.netlify.app,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
YOLO_MODEL_NAME=yolov8n.pt
YOLO_CONF_THRESHOLD=0.25
YOLO_TRACKER=bytetrack.yaml
TRACK_CONF_THRESHOLD=0.25
TRACK_POSITION_HISTORY_LIMIT=50
TRACK_MAX_VIDEO_SIZE_MB=200
LOW_LIGHT_ENABLED=true
LOW_LIGHT_THRESHOLD=70.0
CLAHE_CLIP_LIMIT=2.0
CLAHE_TILE_GRID_SIZE=8x8
